{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/inntal-ki/dsgvo-ki-checkliste/main/schema.json",
  "title": "DSGVO-KI-Checkliste Self-Assessment",
  "description": "Maschinenlesbares Schema für die Erfassung eines DSGVO-KI-Self-Assessments. Passt zu CHECKLIST.md Version 1.1.0.",
  "type": "object",
  "required": ["meta", "sections"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["unternehmen", "vorhaben", "datum"],
      "properties": {
        "unternehmen": { "type": "string" },
        "vorhaben": { "type": "string" },
        "datum": { "type": "string", "format": "date" },
        "bearbeiter": { "type": "string" },
        "checklisten_version": { "type": "string", "default": "1.1.0" }
      }
    },
    "sections": {
      "type": "object",
      "properties": {
        "datenfluesse": { "$ref": "#/$defs/section" },
        "rechtsgrundlage": { "$ref": "#/$defs/section" },
        "ai_act": { "$ref": "#/$defs/section" },
        "technik": { "$ref": "#/$defs/section" },
        "organisation": { "$ref": "#/$defs/section" },
        "wirtschaftlichkeit": { "$ref": "#/$defs/section" },
        "cloud": { "$ref": "#/$defs/section" }
      }
    },
    "gesamturteil": {
      "type": "string",
      "enum": ["freigegeben", "freigegeben_mit_auflagen", "nachbesserung", "gestoppt"]
    },
    "kommentar": { "type": "string" }
  },
  "$defs": {
    "section": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "status"],
            "properties": {
              "id": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
              "status": { "type": "string", "enum": ["offen", "erledigt", "nicht_zutreffend"] },
              "antwort": { "type": "string" },
              "belegt_durch": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
